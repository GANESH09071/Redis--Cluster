def cmd_seed(runtime, args):
    ensure_containers_running(runtime)

    log("Flushing existing data from master nodes...", "INFO")
    topology = get_cluster_topology(runtime)
    if topology:
        for node in topology:
            if node['role'] == 'master':
                container = IP_TO_CONTAINER.get(node['ip'])
                if container:
                    exec_redis_cmd(runtime, container, ['redis-cli', '-p', '6379', 'FLUSHALL'])

    log(f"Seeding {args.keys} keys into cluster...", "INFO")

    commands = []
    for i in range(1, args.keys + 1):
        key = f"key:{i:04d}"
        value = hashlib.sha256(key.encode()).hexdigest()
        commands.append(f"SET {key} {value}")

    commands_str = "\n".join(commands) + "\n"

    rc, stdout, stderr = exec_redis_cmd(runtime, 'redis-node-1', ['redis-cli', '-c', '-p', '6379', 'ping'])
    if rc != 0:
        log(f"Failed to connect to cluster: {stderr}", "ERROR")
        sys.exit(1)


    full_cmd = [runtime, 'exec', '-i', 'redis-node-1', 'redis-cli', '-c', '-p', '6379']
    p = subprocess.Popen(full_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    stdout, stderr = p.communicate(input=commands_str)

    distribution = {ip: 0 for ip in IP_TO_CONTAINER.keys()}
    lines = stdout.splitlines()

    current_node_ip = f"{SUBNET_PREFIX}.11"
    idx = 0
    failures = 0

    for line in lines:
        line = line.strip()
        if not line:
            continue
        if line.startswith('-> Redirected'):
            match = re.search(r'located at ([\d\.]+):', line)
            if match:
                current_node_ip = match.group(1)
        elif line == 'OK':
            distribution[current_node_ip] = distribution.get(current_node_ip, 0) + 1
            idx += 1
        elif 'ERR' in line or 'error' in line.lower():
            failures += 1
            idx += 1

    log("Seeding summary:", "SUCCESS")
    print(f"Total keys inserted: {idx - failures}")
    print(f"Failures: {failures}")
    print("Distribution across masters:")
    for ip, count in distribution.items():
        container = IP_TO_CONTAINER[ip]
        rc, role_check, _ = exec_redis_cmd(runtime, container, ['redis-cli', '-p', '6379', 'role'])
        if 'master' in role_check:
            print(f" - {ip}: {count} keys")

def get_total_keys_in_cluster(runtime):
    topology = get_cluster_topology(runtime)
    if not topology:
        return 0
    total_keys = 0
    for node in topology:
        if node['role'] == 'master':
            container = IP_TO_CONTAINER.get(node['ip'])
            if container:
                _, _, keys = get_node_details(runtime, container)
                total_keys += keys
    return total_keys

def cmd_verify(runtime, args):
    ensure_containers_running(runtime)
    log("Verifying data integrity...", "INFO")

    num_keys = 1000
    if args and hasattr(args, 'keys') and args.keys is not None:
        num_keys = args.keys
    else:
        detected_keys = get_total_keys_in_cluster(runtime)
        if detected_keys > 0:
            num_keys = detected_keys
            log(f"Auto-detected {num_keys} keys in the cluster for verification", "INFO")
        else:
            log("No keys detected in cluster. Defaulting verification to 1000 keys.", "INFO")

    commands = []
    for i in range(1, num_keys + 1):
        key = f"key:{i:04d}"
        commands.append(f"GET {key}")

    commands_str = "\n".join(commands) + "\n"

    full_cmd = [runtime, 'exec', '-i', 'redis-node-1', 'redis-cli', '-c', '-p', '6379']
    p = subprocess.Popen(full_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    stdout, stderr = p.communicate(input=commands_str)

    lines = stdout.splitlines()
    values = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        if line.startswith('-> Redirected'):
            continue
        if line.startswith('"') and line.endswith('"'):
            line = line[1:-1]
        values.append(line)

    verified = 0
    mismatched = 0
    missing = 0

    for i in range(1, num_keys + 1):
        key = f"key:{i:04d}"
        expected_val = hashlib.sha256(key.encode()).hexdigest()

        if i - 1 < len(values):
            actual_val = values[i - 1]
            if actual_val == "nil" or not actual_val:
                missing += 1
            elif actual_val == expected_val:
                verified += 1
            else:
                mismatched += 1
        else:
            missing += 1

    if verified == num_keys:
        log(f"PASS — {verified}/{num_keys} keys verified", "SUCCESS")
        return True
    else:
        log(f"FAIL — {missing} keys missing, {mismatched} values mismatched", "ERROR")
        return False

def backup_cluster_data(runtime):
    try:
        log("Backing up cluster data before rollback...", "INFO")
        topology = get_cluster_topology(runtime)
        if not topology:
            log("No cluster topology found. Skipping backup.", "WARNING")
            return None

        backup_data = []
        lua_script = """
        local keys = redis.call('KEYS', '*')
        local result = {}
        for _, key in ipairs(keys) do
            local key_type = redis.call('TYPE', key).ok
            local ttl = redis.call('PTTL', key)
            local val
            if key_type == 'string' then
                val = redis.call('GET', key)
            elseif key_type == 'hash' then
                val = redis.call('HGETALL', key)
            elseif key_type == 'list' then
                val = redis.call('LRANGE', key, 0, -1)
            elseif key_type == 'set' then
                val = redis.call('SMEMBERS', key)
            elseif key_type == 'zset' then
                val = redis.call('ZRANGE', key, 0, -1, 'WITHSCORES')
            end
            table.insert(result, {key = key, type = key_type, ttl = ttl, value = val})
        end
        return cjson.encode(result)
        """

        for node in topology:
            if node['role'] != 'master':
                continue
            container = IP_TO_CONTAINER.get(node['ip'])
            if not container:
                continue

            rc, stdout, stderr = exec_redis_cmd(runtime, container, ['redis-cli', '-p', '6379', 'EVAL', lua_script, '0'])
            if rc != 0 or not stdout.strip():
                log(f"Failed to backup keys on master {container}: {stderr}", "WARNING")
                continue

            try:
                node_data = json.loads(stdout.strip())
                backup_data.extend(node_data)
            except Exception as e:
                log(f"Failed to parse backup JSON from {container}: {e}", "WARNING")

        log(f"Successfully backed up {len(backup_data)} keys.", "SUCCESS")
        return backup_data
    except Exception as e:
        log(f"Backup failed: {e}", "ERROR")
        return None

def restore_cluster_data(runtime, backup_data):
    if not backup_data:
        log("No backup data to restore.", "INFO")
        return
    try:
        log(f"Restoring {len(backup_data)} keys to the cluster...", "INFO")
        commands = []
        for item in backup_data:
            key = item['key']
            key_type = item['type']
            val = item['value']
            ttl = item['ttl']

            if key_type == 'string':
                escaped_val = val.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')
                commands.append(f'SET "{key}" "{escaped_val}"')
            elif key_type == 'hash':
                hset_parts = [f'HSET "{key}"']
                for i in range(0, len(val), 2):
                    if i + 1 < len(val):
                        fld = val[i].replace('\\', '\\\\').replace('"', '\\"')
                        v = val[i+1].replace('\\', '\\\\').replace('"', '\\"')
                        hset_parts.append(f'"{fld}" "{v}"')
                if len(hset_parts) > 1:
                    commands.append(" ".join(hset_parts))
            elif key_type == 'list':
                rpush_parts = [f'RPUSH "{key}"']
                for v in val:
                    v_esc = v.replace('\\', '\\\\').replace('"', '\\"')
                    rpush_parts.append(f'"{v_esc}"')
                if len(rpush_parts) > 1:
                    commands.append(" ".join(rpush_parts))
            elif key_type == 'set':
                sadd_parts = [f'SADD "{key}"']
                for v in val:
                    v_esc = v.replace('\\', '\\\\').replace('"', '\\"')
                    sadd_parts.append(f'"{v_esc}"')
                if len(sadd_parts) > 1:
                    commands.append(" ".join(sadd_parts))
            elif key_type == 'zset':
                zadd_parts = [f'ZADD "{key}"']
                for i in range(0, len(val), 2):
                    if i + 1 < len(val):
                        member = val[i].replace('\\', '\\\\').replace('"', '\\"')
                        score = val[i+1]
                        zadd_parts.append(f'{score} "{member}"')
                if len(zadd_parts) > 1:
                    commands.append(" ".join(zadd_parts))

            if ttl > 0:
                commands.append(f'PEXPIRE "{key}" {ttl}')

        if not commands:
            return

        commands_str = "\n".join(commands) + "\n"

        full_cmd = [runtime, 'exec', '-i', 'redis-node-1', 'redis-cli', '-c', '-p', '6379']
        p = subprocess.Popen(full_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        stdout, stderr = p.communicate(input=commands_str)
        log("Restore completed.", "SUCCESS")
    except Exception as e:
        log(f"Restore failed: {e}", "ERROR")

def cmd_upgrade(runtime, args):
    ensure_containers_running(runtime)
    log(f"Starting rolling upgrade to version {args.target_version}...", "HEADER")

    log("Step 1: Running pre-flight checks...", "INFO")
    topology = get_cluster_topology(runtime)
    if not topology:
        log("Failed to retrieve cluster topology. Aborting.", "ERROR")
        sys.exit(1)

    for n in topology:
        container = IP_TO_CONTAINER.get(n['ip'])
        rc, _, _ = exec_redis_cmd(runtime, container, ['redis-cli', '-p', '6379', 'ping'])
        if rc != 0:
            log(f"Container {container} ({n['ip']}) is unreachable. Aborting.", "ERROR")
            sys.exit(1)

    all_upgraded = True
    for n in topology:
        container = IP_TO_CONTAINER.get(n['ip'])
        if container:
            ver, _, _ = get_node_details(runtime, container)
            if ver != args.target_version:
                all_upgraded = False
                break
        else:
            all_upgraded = False
            break

    if all_upgraded:
        log(f"Cluster is already at version {args.target_version}. Nothing to do.", "SUCCESS")
        return

    is_rollback = False
    try:
        def parse_ver(v):
            return [int(x) for x in re.findall(r'\d+', v)]
        target_parsed = parse_ver(args.target_version)
        for n in topology:
            container = IP_TO_CONTAINER.get(n['ip'])
            if container:
                node_ver, _, _ = get_node_details(runtime, container)
                if target_parsed < parse_ver(node_ver):
                    is_rollback = True
                    break
    except Exception:
        pass
    if is_rollback:
        log("Rollback/downgrade detected. Replication sync check will be skipped on replicas until master nodes are also downgraded.", "INFO")

    log("Establishing pre-upgrade data baseline...", "INFO")
    if not cmd_verify(runtime, None):
        log("Pre-upgrade verification failed! Aborting upgrade.", "ERROR")
        sys.exit(1)

    backup_data = None
    if is_rollback:
        backup_data = backup_cluster_data(runtime)
        if backup_data:
            try:
                os.makedirs("logs", exist_ok=True)
                with open("logs/rollback_backup.json", "w") as f:
                    json.dump(backup_data, f, indent=2)
                log("Backup saved to logs/rollback_backup.json", "SUCCESS")
            except Exception as e:
                log(f"Failed to write backup file: {e}", "WARNING")

    log("Pre-flight checks passed.", "SUCCESS")

    masters = [n for n in topology if n['role'] == 'master']
    replicas = [n for n in topology if n['role'] == 'replica']

    total_steps = len(topology)
    current_step = 0

    for rep in replicas:
        current_step += 1
        container_name = IP_TO_CONTAINER[rep['ip']]

        current_ver, _, _ = get_node_details(runtime, container_name)
        if current_ver == args.target_version:
            log(f"[{current_step}/{total_steps}] Replica {rep['ip']} is already at version {args.target_version}. Skipping.", "INFO")
            continue

        log(f"[{current_step}/{total_steps}] Upgrading replica {rep['ip']} ({container_name})...", "INFO")

        success = run_playbook('upgrade_node.yml', {
            'target_host': container_name,
            'target_version': args.target_version,
            'skip_sync_wait': is_rollback
        })
        if not success:
            log(f"Upgrade failed on replica {rep['ip']}. Stopping upgrade.", "ERROR")
            sys.exit(1)

        log(f"[{current_step}/{total_steps}] Upgraded replica {rep['ip']} — cluster: ok", "SUCCESS")

    for master in masters:
        current_step += 1
        master_container = IP_TO_CONTAINER[master['ip']]

        current_ver, _, _ = get_node_details(runtime, master_container)
        if current_ver == args.target_version:
            log(f"[{current_step}/{total_steps}] Master {master['ip']} is already at version {args.target_version}. Skipping.", "INFO")
            continue

        master_replica = next((r for r in replicas if r['master_id'] == master['id']), None)
        if not master_replica:
            log(f"Could not find replica for master {master['ip']}. Aborting.", "ERROR")
            sys.exit(1)

        replica_container = IP_TO_CONTAINER[master_replica['ip']]
        log(f"Promoting replica {master_replica['ip']} ({replica_container}) to master...", "INFO")

        success = run_playbook('failover.yml', {
            'target_replica': replica_container,
            'force_takeover': is_rollback
        })
        if not success:
            log(f"Failover failed on replica {master_replica['ip']}. Stopping upgrade.", "ERROR")
            sys.exit(1)

        log(f"Failover complete. Former replica {master_replica['ip']} is now master.", "SUCCESS")
        log(f"[{current_step}/{total_steps}] Upgrading former master {master['ip']} ({master_container})...", "INFO")

        success = run_playbook('upgrade_node.yml', {
            'target_host': master_container,
            'target_version': args.target_version,
            'skip_sync_wait': is_rollback
        })
        if not success:
            log(f"Upgrade failed on former master {master['ip']}. Stopping upgrade.", "ERROR")
            sys.exit(1)

        log(f"[{current_step}/{total_steps}] Upgraded former master {master['ip']} — cluster: ok", "SUCCESS")

    if backup_data:
        restore_cluster_data(runtime, backup_data)

    log("Step 4: Running post-upgrade verification...", "INFO")
    if not cmd_verify(runtime, None):
        log("Post-upgrade data verification failed! Data integrity compromised.", "ERROR")
        sys.exit(1)

    log(f"UPGRADE COMPLETE — all nodes on v{args.target_version}, data integrity verified", "SUCCESS")
    show_status(runtime)

def cmd_verify_full(runtime, args):
    ensure_containers_running(runtime)
    log("Running full cluster verification...", "HEADER")

    topology = get_cluster_topology(runtime)
    if not topology:
        log("Could not read cluster topology.", "ERROR")
        sys.exit(1)

    log("1. Checking Data Integrity...", "INFO")
    data_ok = cmd_verify(runtime, None)

    log("2. Checking Version Consistency...", "INFO")
    versions = set()
    for container in IP_TO_CONTAINER.values():
        v, _, _ = get_node_details(runtime, container)
        versions.add(v)
    version_ok = len(versions) == 1
    if version_ok:
        log(f"PASS — All nodes running version {list(versions)[0]}", "SUCCESS")
    else:
        log(f"FAIL — Inconsistent versions found: {versions}", "ERROR")

    log("3. Checking Topology Health...", "INFO")
    masters = [n for n in topology if n['role'] == 'master']
    replicas = [n for n in topology if n['role'] == 'replica']

    total_slots = 0
    for m in masters:
        for start, end in m['slots']:
            total_slots += (end - start + 1)

    slots_ok = total_slots == 16384

    master_ids_with_replicas = {r['master_id'] for r in replicas}
    replicas_ok = len(master_ids_with_replicas) == len(masters)

    topology_ok = slots_ok and replicas_ok
    if topology_ok:
        log(f"PASS — Topology is healthy (16384 slots covered, all masters have replicas)", "SUCCESS")
    else:
        log(f"FAIL — Topology unhealthy: slots covered = {total_slots}/16384, masters with replicas = {len(master_ids_with_replicas)}/{len(masters)}", "ERROR")

    log("4. Checking Cluster State...", "INFO")
    rc, stdout, _ = exec_redis_cmd(runtime, 'redis-node-1', ['redis-cli', '-p', '6379', 'cluster', 'info'])
    state_ok = False
    if rc == 0:
        for line in stdout.splitlines():
            if line.startswith('cluster_state:'):
                state_ok = 'ok' in line
                break
    if state_ok:
        log("PASS — Cluster state is ok", "SUCCESS")
    else:
        log("FAIL — Cluster state is failing", "ERROR")

    log("5. Checking Replication Lag...", "INFO")
    lag_ok = True
    for r in replicas:
        container = IP_TO_CONTAINER[r['ip']]
        rc, stdout, _ = exec_redis_cmd(runtime, container, ['redis-cli', '-p', '6379', 'info', 'replication'])
        if rc != 0 or 'master_link_status:up' not in stdout:
            lag_ok = False
            log(f"Node {r['ip']} replication link is down!", "ERROR")

    if lag_ok:
        log("PASS — All replicas synced (master_link_status:up)", "SUCCESS")
    else:
        log("FAIL — Replication link down on one or more replicas", "ERROR")

    print("\n" + "="*40)
    print("VERIFICATION SUMMARY")
    print("="*40)
    print(f"1. Data Integrity:      {'PASS' if data_ok else 'FAIL'}")
    print(f"2. Version Consistency: {'PASS' if version_ok else 'FAIL'}")
    print(f"3. Topology Health:     {'PASS' if topology_ok else 'FAIL'}")
    print(f"4. Cluster State:       {'PASS' if state_ok else 'FAIL'}")
    print(f"5. Replication Lag:     {'PASS' if lag_ok else 'FAIL'}")
    print("="*40 + "\n")

    if data_ok and version_ok and topology_ok and state_ok and lag_ok:
        log("Full verification passed successfully!", "SUCCESS")
    else:
        log("Full verification failed.", "ERROR")
        sys.exit(1)

def cmd_status(runtime, args):
    show_status(runtime)


def cmd_scale(runtime, args):
    global IP_TO_CONTAINER, CONTAINER_TO_IP
    ensure_containers_running(runtime)

    if args.add_nodes:
        num = args.add_nodes
        log(f"Scaling out: Adding {num} nodes...", "HEADER")

        if num % 2 != 0:
            log(f"Scaling out requires adding an even number of nodes to form master-replica pairs (e.g., --add-nodes 2). Received {num}.", "ERROR")
            sys.exit(1)

        topology = get_cluster_topology(runtime)
        current_count = len(topology) if topology else 6
        new_nodes = []

        for i in range(num):
            node_num = current_count + i + 1
            ip = f"{SUBNET_PREFIX}.{10 + node_num}"
            name = f"redis-node-{node_num}"
            log(f"Spinning up container {name} with IP {ip}...", "INFO")

            image_name = get_container_image(runtime)
            network_name = get_container_network(runtime)
            cmd = [
                runtime, 'run', '-d',
                '--name', name,
                '--hostname', name,
                '--network', network_name,
                '--ip', ip,
                '-v', f"{os.path.abspath('ansible/ssh')}:/ansible-keys:ro",
                '--restart', 'unless-stopped',
                image_name
            ]
            rc, _, stderr = run_command(cmd)
            if rc != 0:
                cmd[-1] = 'redis-node-base:latest'
                rc, _, stderr = run_command(cmd)
                if rc != 0:
                    cmd[-1] = 'infra-redis-node-1:latest'
                    rc, _, stderr = run_command(cmd)
                    if rc != 0:
                        cmd[-1] = 'submission-redis-node-1:latest'
                        rc, _, stderr = run_command(cmd)
                        if rc != 0:
                            log(f"Failed to spin up scaled node: {stderr}", "ERROR")
                            sys.exit(1)
            new_nodes.append((name, ip))

        with open('ansible/inventory/hosts.ini', 'r') as f:
            lines = f.readlines()

        new_lines = []
        inserted = False
        for line in lines:
            if '[redis_nodes:vars]' in line and not inserted:
                for name, ip in new_nodes:
                    new_lines.append(f"{name} ansible_host={ip}\n")
                inserted = True
            new_lines.append(line)

        with open('ansible/inventory/hosts.ini', 'w') as f:
            f.writelines(new_lines)

        log("Inventory updated with new nodes.", "SUCCESS")

        IP_TO_CONTAINER = load_ip_to_container_mapping(SUBNET_PREFIX)
        CONTAINER_TO_IP = {v: k for k, v in IP_TO_CONTAINER.items()}

        for name, ip in new_nodes:
            log(f"Installing Redis on {name}...", "INFO")
            v, _, _ = get_node_details(runtime, 'redis-node-1')
            success = run_playbook('provision_node.yml', {
                'target_host': name,
                'redis_version': v
            })
            if not success:
                log(f"Failed to provision node {name}.", "ERROR")
                sys.exit(1)

            log(f"Meeting {name} ({ip}) to the cluster...", "INFO")
            exec_redis_cmd(runtime, 'redis-node-1', ['redis-cli', '-p', '6379', 'cluster', 'meet', ip, '6379'])

        log("Waiting 10 seconds for cluster meet gossip to propagate...", "INFO")
        time.sleep(10)

        for idx in range(0, num, 2):
            master_name, master_ip = new_nodes[idx]
            replica_name, replica_ip = new_nodes[idx+1]

            log(f"Configuring replication: {replica_name} ({replica_ip}) -> {master_name} ({master_ip})...", "INFO")

            rc, master_id_out, stderr = exec_redis_cmd(runtime, master_name, ['redis-cli', '-p', '6379', 'cluster', 'myid'])
            if rc != 0 or not master_id_out.strip():
                log(f"Failed to get Node ID for master node {master_name}: {stderr}", "ERROR")
                sys.exit(1)
            master_node_id = master_id_out.strip()
            log(f"Node ID for master {master_name} is {master_node_id}", "INFO")

            rc, rep_out, stderr = exec_redis_cmd(runtime, replica_name, ['redis-cli', '-p', '6379', 'cluster', 'replicate', master_node_id])
            if rc != 0:
                log(f"Failed to make {replica_name} replicate {master_name}: {stderr}", "ERROR")
                sys.exit(1)
            log(f"Replica {replica_name} is now replicating {master_name}.", "SUCCESS")

        log("Waiting 5 seconds for replication topology to settle...", "INFO")
        time.sleep(5)

        log("Rebalancing cluster slots...", "INFO")
        exec_redis_cmd(runtime, 'redis-node-1', ['redis-cli', '--cluster', 'rebalance', f'{SUBNET_PREFIX}.11:6379', '--cluster-use-empty-masters'])
        log("Scale out complete!", "SUCCESS")
        show_status(runtime)

    elif args.remove_node:
        node_id = args.remove_node
        log(f"Scaling in: Removing node {node_id}...", "HEADER")

        topology = get_cluster_topology(runtime)
        if not topology:
            log("Could not read cluster topology.", "ERROR")
            sys.exit(1)

        target_node = None
        if node_id.startswith("redis-node-"):
            ip = CONTAINER_TO_IP.get(node_id)
            if ip:
                for n in topology:
                    if n['ip'] == ip:
                        target_node = n
                        break
        if not target_node:
            for n in topology:
                if n['ip'] == node_id or n['id'] == node_id:
                    target_node = n
                    break

        if not target_node:
            log(f"Could not find node {node_id} in the cluster topology.", "ERROR")
            sys.exit(1)

        master_node = None
        replica_node = None

        if target_node['role'] == 'master':
            master_node = target_node
            for n in topology:
                if n['role'] == 'replica' and n['master_id'] == master_node['id']:
                    replica_node = n
                    break
        elif target_node['role'] == 'replica':
            replica_node = target_node
            for n in topology:
                if n['role'] == 'master' and n['id'] == replica_node['master_id']:
                    master_node = n
                    break
        else:
            log(f"Target node has an unknown role: {target_node['role']}", "ERROR")
            sys.exit(1)

        if master_node:
            log(f"Identified master node: {master_node['ip']} ({master_node['id']})", "INFO")
        if replica_node:
            log(f"Identified replica node: {replica_node['ip']} ({replica_node['id']})", "INFO")

        active_node = None
        for n in topology:
            if (not master_node or n['id'] != master_node['id']) and (not replica_node or n['id'] != replica_node['id']):
                active_node = n
                break

        if not active_node:
            log("No other active node in the cluster to run scale-in operations on.", "ERROR")
            sys.exit(1)

        active_container = IP_TO_CONTAINER.get(active_node['ip'])

        if master_node:
            total_slots = sum(end - start + 1 for start, end in master_node['slots'])
            if total_slots > 0:
                log(f"Master node {master_node['ip']} has {total_slots} slots to migrate.", "INFO")
                other_masters = [n for n in topology if n['role'] == 'master' and n['id'] != master_node['id']]
                if not other_masters:
                    log("Cannot scale in: no other master nodes are left in the cluster to receive the slots.", "ERROR")
                    sys.exit(1)

                slots_remaining = total_slots
                for idx, target in enumerate(other_masters):
                    if idx == len(other_masters) - 1:
                        slots_to_move = slots_remaining
                    else:
                        slots_to_move = total_slots // len(other_masters)

                    if slots_to_move <= 0:
                        continue

                    slots_remaining -= slots_to_move

                    log(f"Migrating {slots_to_move} slots from {master_node['ip']} to {target['ip']}...", "INFO")

                    rc, stdout, stderr = exec_redis_cmd(
                        runtime,
                        active_container,
                        [
                            'redis-cli', '--cluster', 'reshard', f"{active_node['ip']}:6379",
                            '--cluster-from', master_node['id'],
                            '--cluster-to', target['id'],
                            '--cluster-slots', str(slots_to_move),
                            '--cluster-yes'
                        ]
                    )
                    if rc != 0:
                        log(f"Failed to reshard slots from {master_node['ip']} to {target['ip']}: {stderr}\n{stdout}", "ERROR")
                        sys.exit(1)
                    log(f"Migrated {slots_to_move} slots successfully.", "SUCCESS")
            else:
                log(f"Master node {master_node['ip']} has 0 slots assigned. No resharding needed.", "INFO")

        if replica_node:
            log(f"Deleting replica node {replica_node['ip']} from cluster...", "INFO")
            rc, stdout, stderr = exec_redis_cmd(
                runtime,
                active_container,
                ['redis-cli', '--cluster', 'del-node', f"{active_node['ip']}:6379", replica_node['id']]
            )
            if rc != 0:
                log(f"Failed to delete replica node: {stderr}", "WARNING")
            else:
                log("Replica node deleted from cluster.", "SUCCESS")

        if master_node:
            log(f"Deleting master node {master_node['ip']} from cluster...", "INFO")
            rc, stdout, stderr = exec_redis_cmd(
                runtime,
                active_container,
                ['redis-cli', '--cluster', 'del-node', f"{active_node['ip']}:6379", master_node['id']]
            )
            if rc != 0:
                log(f"Failed to delete master node: {stderr}", "WARNING")
            else:
                log("Master node deleted from cluster.", "SUCCESS")

        nodes_to_clean = []
        if replica_node:
            nodes_to_clean.append((IP_TO_CONTAINER.get(replica_node['ip']), replica_node['ip']))
        if master_node:
            nodes_to_clean.append((IP_TO_CONTAINER.get(master_node['ip']), master_node['ip']))

        for container_name, ip in nodes_to_clean:
            if container_name and container_name != 'unknown':
                log(f"Stopping and removing container {container_name}...", "INFO")
                run_command([runtime, 'stop', container_name])
                run_command([runtime, 'rm', container_name])

                log(f"Removing {container_name} from inventory...", "INFO")
                try:
                    with open('ansible/inventory/hosts.ini', 'r') as f:
                        lines = f.readlines()
                    new_lines = []
                    for line in lines:
                        if not line.strip().startswith(container_name):
                            new_lines.append(line)
                    with open('ansible/inventory/hosts.ini', 'w') as f:
                        f.writelines(new_lines)
                    log(f"Removed {container_name} from hosts.ini.", "SUCCESS")
                except Exception as e:
                    log(f"Failed to update inventory for {container_name}: {e}", "WARNING")

        IP_TO_CONTAINER = load_ip_to_container_mapping()
        CONTAINER_TO_IP = {v: k for k, v in IP_TO_CONTAINER.items()}

        log("Scale in complete!", "SUCCESS")
        show_status(runtime)


def cmd_rollback(runtime, args):
    ensure_containers_running(runtime)
    log(f"Rolling back cluster version to {args.target_version}...", "HEADER")
    args.target_version = args.target_version
    cmd_upgrade(runtime, args)


def main():
    parser = argparse.ArgumentParser(description="Redis Cluster Lifecycle Tool")
    subparsers = parser.add_subparsers(dest="command", required=True)

    prov_parser = subparsers.add_parser("provision", help="Provision the Redis cluster")
    prov_parser.add_argument("--version", default="7.0.15", help="Redis version to install")
    prov_parser.add_argument("--masters", type=int, default=3, help="Number of masters")
    prov_parser.add_argument("--replicas-per-master", type=int, default=1, help="Replicas per master")

    seed_parser = subparsers.add_parser("data", help="Data operations")
    seed_subparsers = seed_parser.add_subparsers(dest="subcommand", required=True)

    data_seed_parser = seed_subparsers.add_parser("seed", help="Seed data into cluster")
    data_seed_parser.add_argument("--keys", type=int, default=1000, help="Number of keys to seed")

    data_verify_parser = seed_subparsers.add_parser("verify", help="Verify data integrity")
    data_verify_parser.add_argument("--keys", type=int, default=None, help="Number of keys to verify")



    subparsers.add_parser("status", help="Get cluster status dashboard")

    up_parser = subparsers.add_parser("upgrade", help="Perform zero-downtime rolling upgrade")
    up_parser.add_argument("--target-version", required=True, help="Target Redis version")
    up_parser.add_argument("--strategy", default="rolling", choices=["rolling"], help="Upgrade strategy")

    ver_parser = subparsers.add_parser("verify", help="Run cluster verifications")
    ver_parser.add_argument("--full", action="store_true", required=True, help="Run all verification suites")

    scale_parser = subparsers.add_parser("scale", help="Scale cluster")
    scale_group = scale_parser.add_mutually_exclusive_group(required=True)
    scale_group.add_argument("--add-nodes", type=int, help="Number of nodes to add")
    scale_group.add_argument("--remove-node", help="Node ID to remove")

    rb_parser = subparsers.add_parser("rollback", help="Rollback cluster to target version")
    rb_parser.add_argument("--target-version", required=True, help="Target Redis version to rollback to")

    args = parser.parse_args()

    subcommand = getattr(args, 'subcommand', None)
    setup_output_redirection(args.command, subcommand)

    runtime = prerequisite_check()

    log(f"Running command: {' '.join(sys.argv)}", "INFO")

    if args.command == "provision":
        cmd_provision(runtime, args)
    elif args.command == "data":
        if args.subcommand == "seed":
            cmd_seed(runtime, args)
        elif args.subcommand == "verify":
            cmd_verify(runtime, args)
    elif args.command == "status":
        cmd_status(runtime, args)
    elif args.command == "upgrade":
        cmd_upgrade(runtime, args)
    elif args.command == "verify":
        if args.full:
            cmd_verify_full(runtime, args)
    elif args.command == "scale":
        cmd_scale(runtime, args)
    elif args.command == "rollback":
        cmd_rollback(runtime, args)


if __name__ == "__main__":
    main()
